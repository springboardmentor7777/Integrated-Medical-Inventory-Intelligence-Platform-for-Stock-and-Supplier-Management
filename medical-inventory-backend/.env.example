# Copy values into your operating-system environment; do not commit a real .env file.
DB_URL=jdbc:mysql://localhost:3306/medistock_db?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-database-password
JWT_SECRET=replace-with-a-base64-encoded-32-byte-or-longer-secret
BOOTSTRAP_ADMIN_EMAIL=admin@medistock.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Required only for the cloud profile. Example URL: file:/C:/path/to/tidb-truststore.p12
DB_SSL_TRUSTSTORE_URL=file:/C:/path/to/tidb-truststore.p12
DB_SSL_TRUSTSTORE_PASSWORD=choose-a-local-truststore-password
