# Neon PostgreSQL Database Configuration
# Copy the JDBC URL, username, and password from the Neon connection details.
# Neon URLs normally use sslmode=require, for example:
# jdbc:postgresql://<NEON_HOST>/<NEON_DATABASE>?sslmode=require
DB_URL=jdbc:postgresql://<NEON_HOST>/<NEON_DATABASE>?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_database_password
DB_DRIVER=org.postgresql.Driver
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
